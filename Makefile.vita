```makefile
TARGET = GT2-Vita
TITLEID = GT2V00001

PREFIX = $(VITASDK)/arm-vita-eabi

CC = $(PREFIX)/bin/arm-vita-eabi-gcc
CXX = $(PREFIX)/bin/arm-vita-eabi-g++
CFLAGS = -O2 -Wall -Wextra \
         -I. \
         -Iruntime \
         -Ivita

LDFLAGS =

SOURCES = \
    vita/main.c \
    vita/gt2_vita_platform.c \
    runtime/gt2_runtime.c \
    runtime/gt2_bin.c \
    runtime/ps1_compat/cd.c \
    runtime/ps1_compat/pad.c \
    runtime/ps1_compat/card.c \
    runtime/ps1_compat/gpu.c \
    runtime/ps1_compat/audio.c \
    runtime/ps1_compat/timer.c

OBJECTS = $(SOURCES:.c=.o)

ELF = $(TARGET).elf
VSELF = $(TARGET).self
VPK = $(TARGET).vpk

all: $(VPK)

$(ELF): $(OBJECTS)
	$(CC) $(OBJECTS) $(LDFLAGS) -o $@

$(VSELF): $(ELF)
	vita-make-fself $< $@

param.sfo:
	vita-mksfoex -s TITLE_ID=$(TITLEID) "$(TARGET)" $@

$(VPK): $(VSELF) param.sfo
	mkdir -p sce_sys
	cp param.sfo sce_sys/param.sfo
	vita-pack-vpk \
	-sce_sys/param.sfo=sce_sys/param.sfo \
	-sce_sys/eboot.bin=$(VSELF) \
	$@

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(OBJECTS)
	rm -f $(ELF)
	rm -f $(VSELF)
	rm -f param.sfo
	rm -f $(VPK)

.PHONY: all clean
```
